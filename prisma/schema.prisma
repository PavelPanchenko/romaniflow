generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LessonType {
  FLASHCARDS
  QUIZ
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum BillingInterval {
  MONTHLY
  YEARLY
  LIFETIME
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  EXPIRED
  TRIALING
}

enum Dialect {
  EASTERN_EUROPEAN
  SERVY
  RUSSKA_ROMA
  VLAX_KALDERASH
  LOVARI
  KRYMURYA
}

enum ConceptCategory {
  GREETING
  KINSHIP
  HOME
  FOOD
  NATURE
  BODY
  TIME
  NUMERAL
  VERB_ACTION
  VERB_SPEECH
  ADJECTIVE
  PRONOUN
  PREPOSITION
  PHRASE
  ROAD_HORSE
  RELIGION_FATE
  MUSIC_CRAFT
  OTHER
}

enum FormConfidence {
  VERIFIED
  DRAFT
  UNCERTAIN
}

enum Register {
  STANDARD     // граматическая, словарная норма — попадает в карточки
  COLLOQUIAL   // как реально говорят — показывается сноской на карточке STANDARD-формы
  LITERARY     // книжная/архаичная — также сноской, не плодит карточек
}

model User {
  id               String           @id @default(cuid())
  name             String?
  email            String           @unique
  emailVerified    DateTime?
  image            String?
  passwordHash     String
  preferredDialect Dialect?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  accounts         Account[]
  sessions         Session[]
  progress         LessonProgress[]
  subscriptions    Subscription[]
  paymentEvents    PaymentEvent[]
}

model Course {
  id           String   @id @default(cuid())
  slug         String   @unique
  title        String
  description  String
  dialect      Dialect  @default(EASTERN_EUROPEAN)
  shortLabel   String   @default("")
  isAvailable  Boolean  @default(true)
  modules      Module[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Module {
  id          String   @id @default(cuid())
  title       String
  description String
  order       Int
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons     Lesson[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([courseId, order])
}

model Lesson {
  id               String           @id @default(cuid())
  title            String
  order            Int
  type             LessonType
  isPremium        Boolean          @default(false)
  moduleId         String
  module           Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  items            LessonItem[]
  progress         LessonProgress[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([moduleId, order])
}

model Concept {
  id             String           @id @default(cuid())
  slug           String           @unique
  translationRu  String
  senseNote      String?
  category       ConceptCategory
  frequencyRank  Int?
  swadeshIndex   Int?
  forms          DialectForm[]
  lessonItems    LessonItem[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([category])
  @@index([frequencyRank])
}

model DialectForm {
  id            String           @id @default(cuid())
  conceptId     String
  dialect       Dialect
  romaniWord    String
  transcription String
  ipa           String?
  audioUrl      String?
  sources       String[]         @default([])
  confidence    FormConfidence   @default(DRAFT)
  register      Register         @default(STANDARD)
  notes         String?
  concept       Concept          @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  lessonItems   LessonItem[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([conceptId, dialect, romaniWord])
  @@index([dialect])
}

model LessonItem {
  lessonId       String
  dialectFormId  String
  conceptId      String
  position       Int
  lesson         Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  dialectForm    DialectForm  @relation(fields: [dialectFormId], references: [id], onDelete: Cascade)
  concept        Concept      @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@id([lessonId, dialectFormId])
  @@index([lessonId, position])
}

model LessonProgress {
  id         String         @id @default(cuid())
  userId     String
  lessonId   String
  status     ProgressStatus @default(NOT_STARTED)
  score      Int            @default(0)
  mistakes   String[]       @default([])
  startedAt  DateTime?
  finishedAt DateTime?
  updatedAt  DateTime       @updatedAt
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson     Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model Plan {
  id               String           @id @default(cuid())
  code             String           @unique
  name             String
  description      String
  isDefault        Boolean          @default(false)
  priceCents       Int
  currency         String           @default("EUR")
  billingInterval  BillingInterval
  subscriptions    Subscription[]
  entitlements     Entitlement[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

model Entitlement {
  id              String   @id @default(cuid())
  planId          String
  key             String
  description     String
  plan            Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, key])
}

model Subscription {
  id                    String              @id @default(cuid())
  userId                String
  planId                String
  status                SubscriptionStatus
  currentPeriodStart    DateTime
  currentPeriodEnd      DateTime?
  externalProvider      String?
  externalSubscriptionId String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                  Plan                @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model PaymentEvent {
  id            String   @id @default(cuid())
  userId        String
  provider      String
  eventType     String
  externalId    String?
  payload       Json?
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, provider])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
