DATABASE_URL="postgresql://postgres:postgres@localhost:5432/romaniflow"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-strong-secret"
# Канонический URL для OG, sitemap и JSON-LD (в проде, например https://romaniflow.com)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Docker на сервере: NEXTAUTH_URL и NEXT_PUBLIC_SITE_URL должны совпадать с тем, как вы
# открываете сайт в браузере (http://ВАШ_IP:WEB_PORT или https://домен), не localhost.
